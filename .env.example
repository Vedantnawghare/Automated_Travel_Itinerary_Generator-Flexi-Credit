# Groq API Configuration (LLM Reasoning & Generation)
# Recommended Groq model: openai/gpt-oss-120b or llama-3.3-70b-versatile
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Tavily Search API Configuration (Real-time Travel Research)
TAVILY_API_KEY=your_tavily_api_key_here

# n8n Automation Webhook URL (Triggers Google Calendar & Gmail notifications)
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/travel-itinerary

# SQLite Memory Database Path
DATABASE_PATH=data/travel_memory.db

# Pexels API Configuration (Dynamic Destination & Place Imagery)
PEXELS_API_KEY=your_pexels_api_key_here

# Currency Settings
DEFAULT_CURRENCY=INR
CURRENCY_SYMBOL=₹
